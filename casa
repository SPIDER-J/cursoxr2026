<!DOCTYPE html>

<html lang="es">

<head>

  <meta charset="UTF-8" />

  <title>Casa en A-Frame</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Librería A-Frame -->

  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>

</head>

<body>

  <a-scene background="color: #87CEEB">

    <!-- Iluminación -->

    <a-light type="ambient" color="#ffffff" intensity="0.6"></a-light>

    <a-light 

      type="directional" 

      color="#ffffff" 

      intensity="0.8" 

      position="3 6 4">

    </a-light>

    <!-- Cámara -->

    <a-entity position="0 1.6 6">

      <a-camera></a-camera>

    </a-entity>

    <!-- Suelo -->

    <a-plane 

      position="0 0 0" 

      rotation="-90 0 0" 

      width="20" 

      height="20" 

      color="#4CAF50">

    </a-plane>

    <!-- Cuerpo principal de la casa -->

    <a-box 

      position="0 1 -2" 

      width="4" 

      height="2" 

      depth="3" 

      color="#F5DEB3">

    </a-box>

    <!-- Tejado izquierdo -->

    <a-box 

      position="-1.1 2.25 -2" 

      width="2.8" 

      height="0.25" 

      depth="3.4" 

      color="#8B0000" 

      rotation="0 0 35">

    </a-box>

    <!-- Tejado derecho -->

    <a-box 

      position="1.1 2.25 -2" 

      width="2.8" 

      height="0.25" 

      depth="3.4" 

      color="#8B0000" 

      rotation="0 0 -35">

    </a-box>

    <!-- Puerta -->

    <a-box 

      position="0 0.75 -0.48" 

      width="0.8" 

      height="1.5" 

      depth="0.08" 

      color="#5C3317">

    </a-box>

    <!-- Pomo de la puerta -->

    <a-sphere 

      position="0.28 0.75 -0.55" 

      radius="0.06" 

      color="#FFD700">

    </a-sphere>

    <!-- Ventana izquierda -->

    <a-box 

      position="-1.2 1.25 -0.5" 

      width="0.7" 

      height="0.7" 

      depth="0.08" 

      color="#87CEFA">

    </a-box>

    <!-- Marco ventana izquierda vertical -->

    <a-box 

      position="-1.2 1.25 -0.56" 

      width="0.05" 

      height="0.75" 

      depth="0.04" 

      color="#ffffff">

    </a-box>

    <!-- Marco ventana izquierda horizontal -->

    <a-box 

      position="-1.2 1.25 -0.57" 

      width="0.75" 

      height="0.05" 

      depth="0.04" 

      color="#ffffff">

    </a-box>

    <!-- Ventana derecha -->

    <a-box 

      position="1.2 1.25 -0.5" 

      width="0.7" 

      height="0.7" 

      depth="0.08" 

      color="#87CEFA">

    </a-box>

    <!-- Marco ventana derecha vertical -->

    <a-box 

      position="1.2 1.25 -0.56" 

      width="0.05" 

      height="0.75" 

      depth="0.04" 

      color="#ffffff">

    </a-box>

    <!-- Marco ventana derecha horizontal -->

    <a-box 

      position="1.2 1.25 -0.57" 

      width="0.75" 

      height="0.05" 

      depth="0.04" 

      color="#ffffff">

    </a-box>

    <!-- Chimenea -->

    <a-box 

      position="1.1 3 -2.2" 

      width="0.45" 

      height="1" 

      depth="0.45" 

      color="#7B3F00">

    </a-box>

    <!-- Camino -->

    <a-plane 

      position="0 0.01 1.8" 

      rotation="-90 0 0" 

      width="1.2" 

      height="5" 

      color="#A9A9A9">

    </a-plane>

    <!-- Árbol izquierdo -->

    <a-cylinder 

      position="-4 0.75 -2" 

      radius="0.25" 

      height="1.5" 

      color="#8B4513">

    </a-cylinder>

    <a-sphere 

      position="-4 1.8 -2" 

      radius="0.9" 

      color="#228B22">

    </a-sphere>

    <!-- Árbol derecho -->

    <a-cylinder 

      position="4 0.75 -3" 

      radius="0.25" 

      height="1.5" 

      color="#8B4513">

    </a-cylinder>

    <a-sphere 

      position="4 1.8 -3" 

      radius="0.9" 

      color="#228B22">

    </a-sphere>

    <!-- Sol -->

    <a-sphere 

      position="-5 6 -6" 

      radius="0.8" 

      color="#FFD700">

    </a-sphere>

  </a-scene>

</body>

</html>
